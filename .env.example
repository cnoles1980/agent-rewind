# Never put a real key or an invitation code in source control.
REWIND_DATA_DIR=data
REWIND_ORIGIN=http://127.0.0.1:5173
REWIND_SECURE_COOKIES=false
REWIND_TESTER_CODE_HASH=
REWIND_JUDGE_CODE_HASH=
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
NEBIUS_SANDBOX_IMAGE=
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Keep disabled until access, cancellation, isolation and prices are verified.
REWIND_LIVE_ENABLED=false
REWIND_PRICES_VERIFIED=false
# Reserve a verified WORST CASE, not the average price. Default is provisional.
REWIND_RUN_RESERVATION_CENTS=100
# Analysis is independent of sandbox execution. Enable only after verifying inference prices.
REWIND_ANALYSIS_ENABLED=false
REWIND_ANALYSIS_PRICES_VERIFIED=false
# Provisional: verify worst case for 48 KB UTF-8 evidence + schema/prompt + 6144 output tokens.
REWIND_ANALYSIS_RESERVATION_CENTS=25
# Hosting/disk/other spend and remaining commitments, plus out-of-app testing.
REWIND_NON_EXECUTION_CENTS=3000
